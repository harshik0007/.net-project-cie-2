<%@ Page Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="CommunityGuidelines.aspx.cs" Inherits="CIE_2_PROJECT.CommunityGuidelines" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
    <link rel="stylesheet" href="../Content/Css/CommunityGuidelines.css" />
</asp:Content>

<asp:Content ID="Content2" ContentPlaceHolderID="MainContent" runat="server">

    <div class="community-page">

        <div class="community-header">
            <h1>Community Guidelines</h1>
            <p>Guidelines for maintaining a safe, respectful, and professional SkillLink community.</p>
        </div>

        <div class="community-card">

            <section class="community-section">
                <h2>1. Be Respectful</h2>
                <p>
                    Treat all SkillLink users with respect and professionalism.
                    Harassment, abusive language, discrimination, and threatening
                    behavior are not permitted.
                </p>
            </section>

            <section class="community-section">
                <h2>2. Communicate Professionally</h2>
                <p>
                    Keep communication clear, respectful, and related to the
                    project or service being discussed. Avoid inappropriate or
                    offensive communication.
                </p>
            </section>

            <section class="community-section">
                <h2>3. Provide Accurate Information</h2>
                <p>
                    Users should provide truthful and accurate information about
                    their identity, skills, experience, projects, proposals, and
                    other information shared on SkillLink.
                </p>
            </section>

            <section class="community-section">
                <h2>4. Respect Project Agreements</h2>
                <p>
                    Freelancers and clients should follow the agreed project
                    requirements, pricing, deadlines, and responsibilities.
                    Changes should be communicated clearly between both parties.
                </p>
            </section>

            <section class="community-section">
                <h2>5. Protect Personal Information</h2>
                <p>
                    Do not share another user's private or confidential information
                    without permission. Users should also take reasonable steps
                    to protect their own account information.
                </p>
            </section>

            <section class="community-section">
                <h2>6. No Fraud or Misuse</h2>
                <p>
                    SkillLink must not be used for fraudulent activities,
                    impersonation, unauthorized access, misleading proposals,
                    or other activities that misuse the platform.
                </p>
            </section>

            <section class="community-section">
                <h2>7. Keep Content Appropriate</h2>
                <p>
                    Content shared through SkillLink should be relevant to the
                    platform and appropriate for a professional community.
                    Harmful, abusive, or illegal content is not permitted.
                </p>
            </section>

            <section class="community-section last-section">
                <h2>8. Report Violations</h2>
                <p>
                    If you encounter behavior that violates these guidelines,
                    report the issue through the SkillLink support system so it
                    can be reviewed appropriately.
                </p>
            </section>

        </div>

    </div>

</asp:Content>