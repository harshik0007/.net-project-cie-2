<%@ Page Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="PrivacyPolicy.aspx.cs" Inherits="CIE_2_PROJECT.PrivacyPolicy" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
    <link rel="stylesheet" href="../Content/Css/PrivacyPolicy.css" />
</asp:Content>

<asp:Content ID="Content2" ContentPlaceHolderID="MainContent" runat="server">

    <div class="policy-page">

        <div class="policy-header">
            <h1>Privacy Policy</h1>
            <p>Last updated: 2026</p>
        </div>

        <div class="policy-card">

            <section class="policy-section">
                <h2>1. Introduction</h2>
                <p>
                    SkillLink respects your privacy and is committed to protecting
                    your personal information. This Privacy Policy explains how
                    information is collected, used, and protected when you use
                    the SkillLink platform.
                </p>
            </section>

            <section class="policy-section">
                <h2>2. Information We Collect</h2>
                <p>
                    We may collect information such as your name, email address,
                    phone number, profile information, skills, project details,
                    and account information when you register and use SkillLink.
                </p>
            </section>

            <section class="policy-section">
                <h2>3. How We Use Your Information</h2>
                <p>
                    Your information may be used to create and manage your account,
                    connect freelancers with clients, manage projects and proposals,
                    process payments, and provide platform services.
                </p>
            </section>

            <section class="policy-section">
                <h2>4. Information Protection</h2>
                <p>
                    SkillLink takes reasonable measures to protect user information
                    from unauthorized access, alteration, disclosure, or misuse.
                </p>
            </section>

            <section class="policy-section">
                <h2>5. Sharing of Information</h2>
                <p>
                    Personal information is not shared with other users unless it
                    is required for providing a SkillLink service or is permitted
                    by the user.
                </p>
            </section>

            <section class="policy-section">
                <h2>6. User Responsibilities</h2>
                <p>
                    Users are responsible for keeping their account credentials
                    secure and for providing accurate information while using
                    the platform.
                </p>
            </section>

            <section class="policy-section">
                <h2>7. Changes to This Policy</h2>
                <p>
                    SkillLink may update this Privacy Policy when necessary.
                    Any changes will be reflected on this page.
                </p>
            </section>

            <section class="policy-section last-section">
                <h2>8. Contact Us</h2>
                <p>
                    If you have questions about this Privacy Policy, please
                    contact the SkillLink support team.
                </p>
            </section>

        </div>

    </div>

</asp:Content>