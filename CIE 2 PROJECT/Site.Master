<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="CIE_2_PROJECT.SiteMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">

<head runat="server">

    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>SkillLink</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.css"
          integrity="sha512-x9WwyMYBnlXMNQ6kQ/Lyzu1NqIhLQKL5Oq6xByfXuRj7s9CskyCbLv/1IjqzJmXwFXWr0ov6jBV7Qbc0hh9nHg=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />

    <link rel="stylesheet"
          href="~/Content/Css/Site.css?v=4"
          runat="server" />

    <asp:ContentPlaceHolder
        ID="head"
        runat="server">
    </asp:ContentPlaceHolder>
    <link rel="stylesheet"
          href="~/Content/Css/DesignSystem.css?v=4"
          runat="server" />

</head>

<body>

<form id="form1" runat="server" enctype="multipart/form-data">

<header class="site-header">

    <div class="navbar">


        <!-- =========================
             SKILLLINK LOGO
             ========================= -->

        <a id="brandLink"
           runat="server"
           href="~/Freelancer/FreelancerHome.aspx"
           class="brand">

            <span class="site-brand-mark">S</span>
            <span class="site-brand-wordmark">Skill<span>Link</span></span>

        </a>


        <!-- =========================
             NAVIGATION
             ========================= -->

        <nav class="nav-links">


            <!-- =========================
                 FREELANCER NAVIGATION
                 ========================= -->

            <div id="freelancerNav"
                 runat="server"
                 class="nav-links">


                <a runat="server"
                   href="~/Freelancer/FreelancerHome.aspx"
                   class="nav-link">

                    <i class="fa-solid fa-house nav-icon"></i>

                    <span>Home</span>

                </a>


                <a runat="server"
                   href="~/Freelancer/FindProjects.aspx"
                   class="nav-link">

                    <i class="fa-solid fa-magnifying-glass nav-icon"></i>

                    <span>Find Projects</span>

                </a>


                <a runat="server"
                   href="~/Freelancer/MyProposals.aspx"
                   class="nav-link">

                    <i class="fa-regular fa-circle-check nav-icon"></i>

                    <span>My Proposals</span>

                </a>


                <a runat="server"
                   href="~/Freelancer/ActiveWork.aspx"
                   class="nav-link">

                    <i class="fa-solid fa-briefcase nav-icon"></i>

                    <span>Active Work</span>

                </a>

            </div>


            <!-- =========================
                 CLIENT NAVIGATION
                 ========================= -->

            <div id="clientNav"
                 runat="server"
                 class="nav-links">


                <a runat="server"
                   href="~/Client/ClientHome.aspx"
                   class="nav-link">

                    <i class="fa-solid fa-house nav-icon"></i>

                    <span>Home</span>

                </a>


                <a runat="server"
                   href="~/Client/FindFreelancers.aspx"
                   class="nav-link">

                    <i class="fa-solid fa-magnifying-glass nav-icon"></i>

                    <span>Find Freelancers</span>

                </a>


                <a runat="server"
                   href="~/Client/MyProjects.aspx"
                   class="nav-link">

                    <i class="fa-solid fa-briefcase nav-icon"></i>

                    <span>My Projects</span>

                </a>


                <a runat="server"
                   href="~/Client/Payments.aspx"
                   class="nav-link">

                    <i class="fa-regular fa-credit-card nav-icon"></i>

                    <span>Payments</span>

                </a>

            </div>

        </nav>


        <!-- =========================
             RIGHT NAVIGATION
             ========================= -->

        <div class="nav-right">


            <!-- NOTIFICATIONS -->

            <a runat="server" href="~/Notifications/Notifications.aspx" class="notification" aria-label="Notifications">

                <i class="fa-regular fa-bell"></i>

                <span id="notificationBadge" runat="server" class="notification-badge" visible="false">
                    <asp:Literal ID="litNotificationCount" runat="server" Mode="Encode" />
                </span>

            </a>


            <!-- MESSAGES -->

            <a runat="server" href="~/Messages/Messages.aspx" class="message-icon" aria-label="Messages">

                <i class="fa-regular fa-envelope"></i>
                <span id="messageBadge" runat="server" class="message-badge" visible="false">
                    <asp:Literal ID="litMessageCount" runat="server" Mode="Encode" />
                </span>

            </a>


            <!-- DIVIDER -->

            <div class="profile-divider"></div>


            <!-- =========================
                 FREELANCER PROFILE
                 ========================= -->

            <a id="freelancerProfile"
               runat="server"
               href="~/Freelancer/Profile.aspx"
               class="profile">


                <div class="profile-image">

                    <i class="fa-regular fa-user"></i>

                </div>


                <div class="profile-info">

                    <div class="profile-name">
                        <asp:Literal ID="litFreelancerNavName" runat="server" Mode="Encode" />
                    </div>

                    <div class="profile-role">
                        Freelancer
                    </div>

                </div>


            </a>


            <!-- =========================
                 CLIENT PROFILE
                 ========================= -->

            <a id="clientProfile"
               runat="server"
               href="~/Client/Profile.aspx"
               class="profile">


                <div class="profile-image">

                    <i class="fa-regular fa-user"></i>

                </div>


                <div class="profile-info">

                    <div class="profile-name">
                        <asp:Literal ID="litClientNavName" runat="server" Mode="Encode" />
                    </div>

                    <div class="profile-role">
                        Client
                    </div>

                </div>


            </a>

            <asp:LinkButton ID="logoutLink" runat="server" CssClass="nav-logout" CausesValidation="false" OnClick="logoutLink_Click">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                <span>Log out</span>
            </asp:LinkButton>

        </div>

    </div>

</header>


<!-- =========================
     MAIN CONTENT
     ========================= -->

<main class="main-content">

    <asp:Panel ID="pnlFlashMessage" runat="server" CssClass="site-flash-message" Visible="false" role="status" aria-live="polite">
        <span class="site-flash-icon" aria-hidden="true">
            <i id="flashMessageIcon" runat="server" class="fa-solid fa-circle-check"></i>
        </span>
        <asp:Literal ID="litFlashMessage" runat="server" Mode="Encode" />
        <a id="lnkDismissFlash" runat="server" class="site-flash-dismiss"
           aria-label="Dismiss message" title="Dismiss message">&times;</a>
    </asp:Panel>

    <asp:ContentPlaceHolder
        ID="MainContent"
        runat="server">
    </asp:ContentPlaceHolder>

</main>


<!-- =========================
     FOOTER
     ========================= -->

<footer class="site-footer">

    <div class="footer-content">


        <div class="footer-brand">
            SkillLink
        </div>


        <div class="footer-links">


            <a runat="server"
               href="~/Guidelines/PrivacyPolicy.aspx"
               class="footer-link">

                Privacy Policy

            </a>


            <a runat="server"
               href="~/Guidelines/TermsOfService.aspx"
               class="footer-link">

                Terms of Service

            </a>


            <a runat="server"
               href="~/Guidelines/SupportCenter.aspx"
               class="footer-link">

                Support Center

            </a>


            <a runat="server"
               href="~/Guidelines/CommunityGuidelines.aspx"
               class="footer-link">

                Community Guidelines

            </a>

        </div>


        <div class="copyright">

            &copy;2026 SkillLink Global. All rights reserved.

        </div>

    </div>

</footer>


</form>

</body>

</html>
